# =============================================================================
# .gitattributes — Sanaya
#
# Objectif : rendre les conflits de fichiers GÉNÉRÉS invisibles dans les diffs
# et triviaux à résoudre. Sur un monorepo à deux développeurs, ces fichiers sont
# la première cause de conflits — et ce sont précisément ceux qu'il ne faut
# JAMAIS fusionner à la main : on les régénère.
# =============================================================================

* text=auto eol=lf

# --- Contrat d'API : généré depuis les schémas Zod --------------------------
# En cas de conflit :  git checkout --ours && pnpm api:contract && git add
Code/contracts/openapi.json      linguist-generated=true -diff merge=ours

# --- Dart généré (freezed, json_serializable, retrofit, slang) --------------
# En cas de conflit :  dart run build_runner build --delete-conflicting-outputs
*.g.dart                         linguist-generated=true -diff merge=ours
*.freezed.dart                   linguist-generated=true -diff merge=ours
*.gr.dart                        linguist-generated=true -diff merge=ours
Code/apps/mobile/lib/core/api/generated/**  linguist-generated=true -diff merge=ours
Code/apps/mobile/lib/core/i18n/**.g.dart    linguist-generated=true -diff merge=ours

# --- Scaffold plateforme Flutter (flutter create, FM-01) --------------------
# En cas de conflit : régénérer avec `flutter create --platforms=android,ios .`
Code/apps/mobile/android/**      linguist-generated=true -diff merge=ours
Code/apps/mobile/ios/**          linguist-generated=true -diff merge=ours

# --- Design tokens générés --------------------------------------------------
# En cas de conflit :  pnpm tokens:build
# La seule source à fusionner vraiment est tokens.json.
Code/packages/design-tokens/src/colors.ts       linguist-generated=true -diff merge=ours
Code/packages/design-tokens/src/spacing.ts      linguist-generated=true -diff merge=ours
Code/packages/design-tokens/src/typography.ts   linguist-generated=true -diff merge=ours
Code/packages/design-tokens/tailwind-preset.js  linguist-generated=true -diff merge=ours
Code/apps/mobile/lib/core/theme/app_colors.dart  linguist-generated=true -diff merge=ours
Code/apps/mobile/lib/core/theme/app_spacing.dart linguist-generated=true -diff merge=ours
Code/apps/mobile/lib/core/theme/app_text.dart    linguist-generated=true -diff merge=ours

# --- Client Prisma généré ---------------------------------------------------
Code/packages/db/generated/**     linguist-generated=true -diff

# --- Lockfile ---------------------------------------------------------------
# NE PAS mettre merge=ours ici : on perdrait des dépendances silencieusement.
# En cas de conflit :  git checkout --theirs pnpm-lock.yaml && pnpm install
Code/pnpm-lock.yaml               -diff
Code/apps/mobile/pubspec.lock     -diff

# --- Binaires ---------------------------------------------------------------
*.png    binary
*.jpg    binary
*.webp   binary
*.ttf    binary
*.otf    binary
*.apk    binary
*.keystore binary
*.jks    binary

# --- Ne jamais normaliser -----------------------------------------------------
*.sh     text eol=lf
gradlew  text eol=lf
