{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "Serveur Fastify 5 + Zod + OpenAPI — transport uniquement (ADR-001).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../../.env src/start.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../../.env dist/start.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "api:contract": "tsx --env-file-if-exists=../../../.env src/openapi.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@repo/constants": "workspace:*",
    "@repo/core": "workspace:*",
    "fastify": "5.12.0",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "eslint": "10.8.1",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
