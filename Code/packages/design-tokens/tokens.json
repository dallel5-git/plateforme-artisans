{
  "$meta": {
    "name": "Sanaya Design Tokens",
    "version": "1.0.0",
    "source": "TODO(FM-15x) : référence exacte des nouvelles maquettes (direction artistique 2026-09) à confirmer — la source précédente (extraction 2026-08-15) est périmée depuis FM-15",
    "note": "SOURCE UNIQUE DE VÉRITÉ. Ne jamais éditer les fichiers générés (colors.ts, app_colors.dart). Modifier ce fichier puis lancer `pnpm tokens:build`.",
    "targets": [
      "packages/design-tokens/src/colors.ts",
      "packages/design-tokens/src/spacing.ts",
      "packages/design-tokens/src/typography.ts",
      "packages/design-tokens/tailwind-preset.js",
      "apps/mobile/lib/core/theme/app_colors.dart",
      "apps/mobile/lib/core/theme/app_elevation.dart",
      "apps/mobile/lib/core/theme/app_motion.dart",
      "apps/mobile/lib/core/theme/app_spacing.dart",
      "apps/mobile/lib/core/theme/app_text.dart"
    ]
  },

  "color": {
    "brand": {
      "50":  "#EEF3FD",
      "100": "#DFECFF",
      "200": "#C2D6F8",
      "300": "#95B4F0",
      "400": "#6690E8",
      "500": "#3B6FE0",
      "600": "#2A57C4",
      "700": "#1F449C",
      "800": "#1559B5",
      "900": "#132F6B"
    },
    "neutral": {
      "0":   "#FFFFFF",
      "25":  "#FCFCFA",
      "50":  "#F3F2ED",
      "100": "#ECEEF0",
      "200": "#E9ECF0",
      "300": "#D3D7DE",
      "400": "#A8B0BD",
      "500": "#78818F",
      "600": "#525C6B",
      "700": "#343D4B",
      "800": "#1F2733",
      "900": "#141A24",
      "950": "#11161F",
      "1000": "#0A0D12"
    },
    "success": {
      "50":  "#E8F6EE",
      "100": "#C6E9D6",
      "500": "#1E7F4C",
      "600": "#17603A",
      "700": "#0F4527"
    },
    "warning": {
      "50":  "#FEF5E6",
      "100": "#FBE6BF",
      "500": "#A9640A",
      "600": "#8A5605",
      "700": "#6B4204"
    },
    "danger": {
      "50":  "#FDECEC",
      "100": "#F8CFCF",
      "500": "#D93B3B",
      "600": "#B32C2C",
      "700": "#8C2020"
    },
    "info": {
      "50":  "#E9F2FE",
      "500": "#2C7BE5"
    },

    "semantic": {
      "light": {
        "background":        "{color.neutral.25}",
        "surface":           "{color.neutral.0}",
        "surface-raised":    "{color.neutral.0}",
        "surface-sunken":    "{color.neutral.50}",
        "border":            "{color.neutral.200}",
        "border-strong":     "{color.neutral.300}",
        "text-primary":      "{color.neutral.900}",
        "text-secondary":    "{color.neutral.600}",
        "text-muted":        "{color.neutral.500}",
        "text-inverse":      "{color.neutral.0}",
        "accent":            "{color.brand.500}",
        "accent-hover":      "{color.brand.600}",
        "accent-subtle":     "{color.brand.50}",
        "on-accent":         "{color.neutral.0}",
        "verified":          "{color.success.500}",
        "verified-subtle":   "{color.success.50}",
        "pending":           "{color.warning.500}",
        "pending-subtle":    "{color.warning.50}",
        "destructive":       "{color.danger.500}",
        "destructive-subtle":"{color.danger.50}",
        "rating":            "#C77800",
        "sponsored":         "#B8860B",
        "whatsapp":          "#128C7E",
        "on-whatsapp":       "#FFFFFF",
        "amber":             "#C77800",
        "on-amber":          "#FFFFFF",
        "scrim":             "#2B2F36",
        "on-scrim":          "#FFFFFF",
        "thumbnail":         "{color.neutral.50}",
        "thumbnail-border":  "{color.neutral.200}",
        "chart-bar":         "{color.brand.300}",
        "chart-bar-highlight":"{color.brand.500}",
        "nav-active":        "{color.brand.500}",
        "nav-inactive":      "{color.neutral.500}",
        "nav-background":    "{color.neutral.0}"
      },
      "dark": {
        "background":        "{color.neutral.1000}",
        "surface":           "{color.neutral.900}",
        "surface-raised":    "{color.neutral.800}",
        "surface-sunken":    "{color.neutral.950}",
        "border":            "#2A3441",
        "border-strong":     "{color.neutral.700}",
        "text-primary":      "{color.neutral.25}",
        "text-secondary":    "{color.neutral.400}",
        "text-muted":        "{color.neutral.500}",
        "text-inverse":      "{color.neutral.900}",
        "accent":            "{color.brand.400}",
        "accent-hover":      "{color.brand.300}",
        "accent-subtle":     "#1A2440",
        "on-accent":         "{color.neutral.1000}",
        "verified":          "#3FBF7F",
        "verified-subtle":   "#0F2A1C",
        "pending":           "#E8A72B",
        "pending-subtle":    "#2E2210",
        "destructive":       "#F26D6D",
        "destructive-subtle":"#2E1414",
        "rating":            "#F5A623",
        "sponsored":         "#C99A2E",
        "whatsapp":          "#25D366",
        "on-whatsapp":       "#FFFFFF",
        "amber":             "#F5A623",
        "on-amber":          "#141A24",
        "scrim":             "#05070A",
        "on-scrim":          "#FFFFFF",
        "thumbnail":         "#232C39",
        "thumbnail-border":  "{color.neutral.700}",
        "chart-bar":         "{color.brand.600}",
        "chart-bar-highlight":"{color.brand.400}",
        "nav-active":        "{color.brand.400}",
        "nav-inactive":      "{color.neutral.400}",
        "nav-background":    "{color.neutral.900}"
      }
    }
  },

  "spacing": {
    "0": "0px",
    "xxs": "2px",
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "2xl": "32px",
    "3xl": "48px",
    "4xl": "64px",
    "5xl": "96px"
  },

  "radius": {
    "none": "0px",
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "20px",
    "pill": "999px"
  },

  "iconSize": {
    "xs": "12px",
    "sm": "16px",
    "md": "20px",
    "lg": "24px",
    "xl": "32px"
  },

  "typography": {
    "family": {
      "latin": "Manrope",
      "arabic": "Noto Kufi Arabic",
      "mono": "JetBrains Mono"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    },
    "scale": {
      "display": { "size": "36px", "lineHeight": "42px", "weight": 800, "tracking": "-0.02em" },
      "h1":      { "size": "28px", "lineHeight": "34px", "weight": 800, "tracking": "-0.02em" },
      "h2":      { "size": "22px", "lineHeight": "28px", "weight": 700, "tracking": "-0.01em" },
      "h3":      { "size": "18px", "lineHeight": "24px", "weight": 700, "tracking": "0" },
      "subtitle":{ "size": "16px", "lineHeight": "24px", "weight": 600, "tracking": "0" },
      "body":    { "size": "15px", "lineHeight": "22px", "weight": 400, "tracking": "0" },
      "bodyStrong": { "size": "15px", "lineHeight": "22px", "weight": 600, "tracking": "0" },
      "small":   { "size": "13px", "lineHeight": "18px", "weight": 400, "tracking": "0" },
      "caption": { "size": "11px", "lineHeight": "14px", "weight": 600, "tracking": "0.04em" }
    }
  },

  "elevation": {
    "light": {
      "none": [],
      "sm": [{ "x": "0px", "y": "1px", "blur": "2px", "spread": "0px", "color": "rgba(20, 26, 36, 0.06)" }],
      "md": [{ "x": "0px", "y": "4px", "blur": "12px", "spread": "0px", "color": "rgba(20, 26, 36, 0.08)" }],
      "lg": [{ "x": "0px", "y": "12px", "blur": "32px", "spread": "0px", "color": "rgba(20, 26, 36, 0.12)" }]
    },
    "dark": {
      "none": [],
      "sm": [{ "x": "0px", "y": "1px", "blur": "2px", "spread": "0px", "color": "rgba(0, 0, 0, 0.32)" }],
      "md": [{ "x": "0px", "y": "4px", "blur": "12px", "spread": "0px", "color": "rgba(0, 0, 0, 0.40)" }],
      "lg": [{ "x": "0px", "y": "12px", "blur": "32px", "spread": "0px", "color": "rgba(0, 0, 0, 0.48)" }]
    }
  },

  "motion": {
    "duration": { "fast": "120ms", "base": "200ms", "slow": "320ms" },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)", "decelerate": "cubic-bezier(0, 0, 0, 1)" }
  },

  "layout": {
    "touchTarget": "48px",
    "containerMax": "1200px",
    "breakpoint": { "sm": "480px", "md": "768px", "lg": "1024px", "xl": "1280px" }
  }
}
