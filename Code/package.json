{
  "name": "sanaya",
  "version": "0.0.0",
  "private": true,
  "description": "Sanaya — monorepo (apps/api, apps/web, apps/admin, apps/worker, packages/*). apps/mobile est un projet Flutter séparé, hors workspace pnpm.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f tooling/docker/docker-compose.dev.yml --env-file ../.env up -d --wait",
    "db:down": "docker compose -f tooling/docker/docker-compose.dev.yml --env-file ../.env down",
    "db:reset": "bash tooling/scripts/reset-db.sh"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.10.10",
    "typescript": "5.9.3"
  }
}
