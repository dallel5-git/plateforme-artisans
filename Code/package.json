{
  "name": "sanaya",
  "version": "0.0.0",
  "private": true,
  "description": "Sanaya — monorepo (apps/api, apps/web, apps/admin, apps/worker, packages/*). apps/mobile est un projet Flutter séparé, hors workspace pnpm.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f tooling/docker/docker-compose.dev.yml --env-file ../.env up -d --wait",
    "db:down": "docker compose -f tooling/docker/docker-compose.dev.yml --env-file ../.env down",
    "db:reset": "bash tooling/scripts/reset-db.sh",
    "db:migrate": "pnpm --filter @repo/db migrate:dev",
    "db:seed": "pnpm --filter @repo/db seed && tsx --env-file-if-exists=../.env tooling/scripts/flush-catalog-cache.ts",
    "db:seed:dev": "pnpm --filter @repo/db seed:dev",
    "db:studio": "pnpm --filter @repo/db studio",
    "api:contract": "turbo run api:contract",
    "api:contract:check": "turbo run api:contract -- --check",
    "i18n:check": "node tooling/scripts/i18n-check.mjs",
    "tokens:build": "node tooling/scripts/build-tokens.mjs",
    "tokens:build:check": "node tooling/scripts/build-tokens.mjs --check",
    "web:client": "node tooling/scripts/web-client.mjs",
    "web:client:check": "node tooling/scripts/web-client.mjs --check"
  },
  "devDependencies": {
    "ioredis": "6.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "turbo": "2.10.10",
    "typescript": "5.9.3"
  }
}
