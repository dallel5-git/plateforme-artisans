# Copier en .env (jamais commité) puis lancer `pnpm db:up` depuis Code/.
# Valeurs factices — usage local uniquement (POLITIQUE-PROJET.md §7.1).

# --- PostgreSQL (tooling/docker/docker-compose.dev.yml) ---------------------
POSTGRES_USER=sanaya
POSTGRES_PASSWORD=sanaya_dev_password
POSTGRES_DB=sanaya
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sanaya:sanaya_dev_password@localhost:5432/sanaya
DIRECT_DATABASE_URL=postgresql://sanaya:sanaya_dev_password@localhost:5432/sanaya

# --- Redis (tooling/docker/docker-compose.dev.yml) --------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- apps/api -----------------------------------------------------------------
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=*

# --- packages/notifications (BE-08) ------------------------------------------
# console : logge l'OTP en développement (jamais en production, voir ConsoleSmsProvider).
# twilio  : pas encore implémenté (S2).
SMS_PROVIDER=console

# --- packages/core/auth (BE-09) -----------------------------------------------
# Secret HS256 des access tokens. Valeur factice ici — en production, secret fort en coffre.
JWT_ACCESS_SECRET=dev_jwt_access_secret_change_me
